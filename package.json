{
  "name": "tenantpanel",
  "packageManager": "yarn@4.5.0",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "tsc && vite build",
    "test": "vitest run",
    "serve": "vite preview",
    "lint": "node scripts/check-lint.mjs",
    "build:visual-css": "tailwindcss -c visual-builder.tailwind.cjs -i src/visual-engine/host/utilities.input.css -o src/visual-engine/host/utilities.css --minify",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "release:check": "yarn test:lint && yarn test:coverage-gate && yarn test:server && yarn test:deployment && yarn test:performance-gate && yarn lint && yarn test:coverage && yarn build && yarn templates:check && yarn check:bundle",
    "lint:report": "eslint .",
    "lint:baseline": "node scripts/check-lint.mjs --update",
    "test:e2e": "playwright test",
    "e2e:install": "playwright install chromium",
    "analyze": "ANALYZE=true vite build",
    "audit:high": "yarn npm audit --severity high --recursive",
    "test:lint": "node --test scripts/lint-ratchet.test.mjs",
    "test:coverage": "vitest run --coverage --maxWorkers=1 --minWorkers=1 && node scripts/check-coverage.mjs",
    "coverage:ratchet": "vitest run --coverage --maxWorkers=1 --minWorkers=1 && node scripts/check-coverage.mjs --ratchet",
    "test:coverage-gate": "node --test scripts/coverage-ratchet.test.mjs",
    "templates:catalog": "node scripts/generate-starter-catalog.mjs",
    "templates:check": "node scripts/generate-starter-catalog.mjs --check",
    "test:performance": "node scripts/check-performance.mjs",
    "test:server": "node --test server/*.test.mjs",
    "test:performance-gate": "node --test scripts/performance-results.test.mjs",
    "verify:live": "node scripts/verify-live-headers.mjs",
    "test:deployment": "node --test scripts/verify-live-headers.test.mjs scripts/secret-scan-range.test.mjs"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@headlessui/react": "^1.7.16",
    "@heroicons/react": "^2.0.13",
    "@react-three/fiber": "^8.18.0",
    "@react-three/postprocessing": "^2.19.1",
    "@sentry/react": "^10.26.0",
    "@tanstack/react-query": "^5.90.5",
    "axios": "^1.11.0",
    "clsx": "2.1.1",
    "date-fns": "^3.6.0",
    "gsap": "^3.15.0",
    "i18next": "^23.11.5",
    "i18next-browser-languagedetector": "^8.0.0",
    "lodash": "^4.17.24",
    "matter-js": "^0.20.0",
    "motion": "^13.2.0",
    "ogl": "^1.0.11",
    "postprocessing": "^6.39.4",
    "react": "^18.2.0",
    "react-color": "^2.19.3",
    "react-day-picker": "^8.10.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^14.1.2",
    "react-icons": "^5.2.1",
    "react-input-mask": "^2.0.4",
    "react-router-dom": "^7.9.5",
    "react-select": "^5.8.0",
    "react-toastify": "^10.0.5",
    "tailwind-merge": "2.6.1",
    "three": "^0.180.0",
    "vgpu": "^0.4.1",
    "web-vitals": "^5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^8.57.0",
    "@lhci/cli": "^0.16.1",
    "@playwright/test": "^1.56.1",
    "@sentry/vite-plugin": "^4.6.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/eslint-plugin-jsx-a11y": "^6",
    "@types/lodash": "^4.17.20",
    "@types/matter-js": "^0",
    "@types/node": "^25.0.3",
    "@types/react": "^18.3.3",
    "@types/react-color": "^3.0.12",
    "@types/react-dom": "^18.3.0",
    "@types/react-input-mask": "^3.0.5",
    "@types/three": "^0.180.0",
    "@typescript-eslint/eslint-plugin": "^7.13.1",
    "@typescript-eslint/parser": "^7.13.1",
    "@vitejs/plugin-react": "^5.1.0",
    "@vitest/coverage-v8": "3.2.7",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.7",
    "globals": "^15.15.0",
    "jsdom": "29.0.1",
    "playwright-core": "1.65.1",
    "postcss": "^8.4.38",
    "rollup-plugin-visualizer": "^6.0.5",
    "svgo": "^4.1.0",
    "tailwindcss": "^3.4.4",
    "typescript": "^7.0.2",
    "vite": "^7.3.0",
    "vite-plugin-svgr": "^4.2.0",
    "vite-tsconfig-paths": "^4.3.2",
    "vitest": "^3.2.6"
  },
  "resolutions": {
    "glob": "^11.0.0",
    "@modelcontextprotocol/server": "2.4.0",
    "tinypool": "2.2.0"
  },
  "engines": {
    "node": ">=22.22.0 <23"
  },
  "license": "MIT"
}
